map [normal] '<KPAdd>' zoom in

# -: Изменить масштаб всего документа.
map [normal] - zoom out

# <KPSubtract>: Изменить масштаб всего документа.
map [normal] '<KPSubtract>' zoom out

# =: Изменить масштаб всего документа.
map [normal] = zoom specific

