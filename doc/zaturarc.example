# 7: Регулировка изображения; уменьшить/увеличить насыщенность. Диапазон -100…100.
map [presentation] 7 adjust_saturation down

# 8: Регулировка изображения; уменьшить/увеличить насыщенность. Диапазон -100…100.
map [presentation] 8 adjust_saturation up

# Режим [index]

# <C-c>: Показать/скрыть оглавление.
map [index] '<C-c>' toggle_index

# <Esc>: Показать/скрыть оглавление.
map [index] '<Esc>' toggle_index

# <C-[>: Показать/скрыть оглавление.
map [index] '<C-[>' toggle_index

# q: Закрыть программу.
map [index] q quit

# <F11>: Включить/выключить полноэкранное окно (режим клавиш не меняется).
map [index] '<F11>' toggle_fullscreen

# <Tab>: Показать/скрыть оглавление.
map [index] '<Tab>' toggle_index

# k: Навигация/сворачивание/выбор пункта оглавления.
map [index] k navigate_index up

# j: Навигация/сворачивание/выбор пункта оглавления.
map [index] j navigate_index down

# <C-d>: Навигация/сворачивание/выбор пункта оглавления.
map [index] '<C-d>' navigate_index half-down

# <C-u>: Навигация/сворачивание/выбор пункта оглавления.
map [index] '<C-u>' navigate_index half-up

# h: Навигация/сворачивание/выбор пункта оглавления.
map [index] h navigate_index collapse

# zc: Навигация/сворачивание/выбор пункта оглавления.
map [index] zc navigate_index collapse

# zC: Навигация/сворачивание/выбор пункта оглавления.
map [index] zC navigate_index collapse-recursive

# H: Навигация/сворачивание/выбор пункта оглавления.
map [index] H navigate_index collapse-all

# zM: Навигация/сворачивание/выбор пункта оглавления.
map [index] zM navigate_index collapse-all

# l: Навигация/сворачивание/выбор пункта оглавления.
map [index] l navigate_index expand

# zo: Навигация/сворачивание/выбор пункта оглавления.
map [index] zo navigate_index expand

# zO: Навигация/сворачивание/выбор пункта оглавления.
map [index] zO navigate_index expand-recursive

# L: Навигация/сворачивание/выбор пункта оглавления.
map [index] L navigate_index expand-all

# zR: Навигация/сворачивание/выбор пункта оглавления.
map [index] zR navigate_index expand-all

# <Up>: Навигация/сворачивание/выбор пункта оглавления.
map [index] '<Up>' navigate_index up

# <KPUp>: Навигация/сворачивание/выбор пункта оглавления.
map [index] '<KPUp>' navigate_index up

# <Down>: Навигация/сворачивание/выбор пункта оглавления.
map [index] '<Down>' navigate_index down

# <KPDown>: Навигация/сворачивание/выбор пункта оглавления.
map [index] '<KPDown>' navigate_index down

# <Left>: Навигация/сворачивание/выбор пункта оглавления.
map [index] '<Left>' navigate_index collapse

# <KPLeft>: Навигация/сворачивание/выбор пункта оглавления.
map [index] '<KPLeft>' navigate_index collapse

# <Right>: Навигация/сворачивание/выбор пункта оглавления.
map [index] '<Right>' navigate_index expand

# <KPRight>: Навигация/сворачивание/выбор пункта оглавления.
map [index] '<KPRight>' navigate_index expand

# <Space>: Навигация/сворачивание/выбор пункта оглавления.
map [index] '<Space>' navigate_index select

# <Return>: Навигация/сворачивание/выбор пункта оглавления.
map [index] '<Return>' navigate_index select

# <C-j>: Навигация/сворачивание/выбор пункта оглавления.
map [index] '<C-j>' navigate_index select

# gg: Навигация/сворачивание/выбор пункта оглавления.
map [index] gg navigate_index top

# G: Навигация/сворачивание/выбор пункта оглавления.
map [index] G navigate_index bottom

# Режим [insert]

# <C-c>: Отменить действие/выделение, скрыть поиск согласно abort-clear-search.
map [insert] '<C-c>' abort

# <Esc>: Отменить действие/выделение, скрыть поиск согласно abort-clear-search.
map [insert] '<Esc>' abort

# <C-[>: Отменить действие/выделение, скрыть поиск согласно abort-clear-search.
map [insert] '<C-[>' abort

# q: Закрыть программу.
map [insert] q quit

# <F11>: Включить/выключить полноэкранное окно (режим клавиш не меняется).
map [insert] '<F11>' toggle_fullscreen

# Режим [inputbar]

# <F11>: Включить/выключить полноэкранное окно (режим клавиш не меняется).
map [inputbar] '<F11>' toggle_fullscreen

# <Esc>: Отменить действие/выделение, скрыть поиск согласно abort-clear-search.
map [inputbar] '<Esc>' abort

# <C-c>: Отменить действие/выделение, скрыть поиск согласно abort-clear-search.
map [inputbar] '<C-c>' abort

# <C-j>: Выполнить введённую команду/поиск.
map [inputbar] '<C-j>' input_activate

# <C-[>: Отменить ввод и вернуться к чтению.
map [inputbar] '<C-[>' input_abort

# <Tab>: Выбрать пункт или группу автодополнения.
map [inputbar] '<Tab>' input_completion input-next

# <C-Tab>: Выбрать пункт или группу автодополнения.
map [inputbar] '<C-Tab>' input_completion input-next-group

# <ShiftTab>: Выбрать пункт или группу автодополнения.
map [inputbar] '<ShiftTab>' input_completion input-previous

# <C-ShiftTab>: Выбрать пункт или группу автодополнения.
map [inputbar] '<C-ShiftTab>' input_completion input-previous-group

# <BackSpace>: Редактировать строку команды/поиска.
map [inputbar] '<BackSpace>' input_edit delete-last-char

# <C-h>: Редактировать строку команды/поиска.
map [inputbar] '<C-h>' input_edit delete-last-char

# <C-u>: Редактировать строку команды/поиска.
map [inputbar] '<C-u>' input_edit delete-to-line-start

# <C-k>: Редактировать строку команды/поиска.
map [inputbar] '<C-k>' input_edit delete-to-line-end

# <C-d>: Редактировать строку команды/поиска.
map [inputbar] '<C-d>' input_edit delete-current-char

# <C-w>: Редактировать строку команды/поиска.
map [inputbar] '<C-w>' input_edit delete-last-word

# <C-f>: Редактировать строку команды/поиска.
map [inputbar] '<C-f>' input_edit next-char

# <C-b>: Редактировать строку команды/поиска.
map [inputbar] '<C-b>' input_edit previous-char

# <Right>: Редактировать строку команды/поиска.
map [inputbar] '<Right>' input_edit next-char

# <Left>: Редактировать строку команды/поиска.
map [inputbar] '<Left>' input_edit previous-char

# <C-a>: Редактировать строку команды/поиска.
map [inputbar] '<C-a>' input_edit line-start

# <C-e>: Редактировать строку команды/поиска.
map [inputbar] '<C-e>' input_edit line-end

# <Up>: Выбрать предыдущую/следующую введённую команду.
map [inputbar] '<Up>' input_history input-previous

# <Down>: Выбрать предыдущую/следующую введённую команду.
map [inputbar] '<Down>' input_history input-next

# <C-p>: Выбрать предыдущую/следующую введённую команду.
map [inputbar] '<C-p>' input_history input-previous

# <C-n>: Выбрать предыдущую/следующую введённую команду.
map [inputbar] '<C-n>' input_history input-next

# =================== МЫШЬ / ТАЧПАД ===================
# Встроенные мышиные действия перечислены полностью. Строки ниже — справка:
# sc_mouse_scroll/sc_mouse_zoom обрабатывают дельты и состояния кнопок и
# не равны обычным scroll/zoom. Замена их map меняет поведение жестов.
# ЛКМ по тексту — выделить/копировать; по ссылке — открыть согласно double-click-follow.
# Модификатор highlighter-modifier + ЛКМ — прямоугольное выделение.
# synctex-edit-modifier + ЛКМ — обратный SyncTeX (если включён в сборке).
# [normal] колесо вверх → прокрутка вверх.
# [normal] колесо вниз → прокрутка вниз.
# [normal] прокрутка влево → прокрутка влево.
# [normal] прокрутка вправо → прокрутка вправо.
# [normal] плавный жест тачпада → прокрутка в двух направлениях.
# [normal] Shift + колесо вверх → прокрутка влево.
# [normal] Shift + колесо вниз → прокрутка вправо.
# [normal] Ctrl + колесо вверх → масштабирование.
# [normal] Ctrl + колесо вниз → масштабирование.
# [normal] Ctrl + плавный жест тачпада → масштабирование.
# [normal] нажатие средней кнопки → прокрутка перетаскиванием.
# [normal] при удержании средней кнопки: отпускание средней кнопки → прокрутка перетаскиванием.
# [normal] при удержании средней кнопки: перемещение указателя → прокрутка перетаскиванием.
# [presentation] колесо вверх → прокрутка вверх.
# [presentation] колесо вниз → прокрутка вниз.
# [presentation] прокрутка влево → прокрутка влево.
# [presentation] прокрутка вправо → прокрутка вправо.
# [presentation] нажатие ЛКМ → следующая страница.
# [presentation] нажатие ПКМ → предыдущая страница.
# [presentation] Shift + колесо вверх → прокрутка влево.
# [presentation] Shift + колесо вниз → прокрутка вправо.
# [presentation] Ctrl + колесо вверх → масштабирование.
# [presentation] Ctrl + колесо вниз → масштабирование.

# =================== СПРАВОЧНИК ФУНКЦИЙ ===================
# Функции без стандартного назначения можно привязать собственной строкой map.
# abort: Отменить действие/выделение, скрыть поиск согласно abort-clear-search.
# adjust_book_font: Изменить размер текста книги на один пункт.
# adjust_brightness: Регулировка изображения; уменьшить/увеличить яркость. Диапазон -100…100.
# adjust_contrast: Регулировка изображения; уменьшить/увеличить контраст. Диапазон -100…100.
# adjust_gamma: Регулировка изображения; уменьшить/увеличить гамму. Диапазон -100…100.
# adjust_saturation: Регулировка изображения; уменьшить/увеличить насыщенность. Диапазон -100…100.
# adjust_window: Подогнать страницу/разворот под окно.
# bisect: Переместиться по документу двоичным поиском.
# change_mode: Переключить режим: normal, insert, index или presentation.
# copy_filepath: Копировать путь текущего файла.
# copy_link: Копировать адрес ссылки.
# cycle_first_column: Изменить колонку первой страницы разворота.
# display_link: Показать адрес выбранной ссылки.
# exec: Выполнить внешнюю команду exec-command.
# feedkeys: Выполнить переданную строку как последовательность нажатий клавиш.
# file_chooser: Выбрать документ в системном диалоге.
# focus_inputbar: Открыть строку команд/поиск с заданным текстом; append-filepath добавляет путь.
# follow: Открыть ссылку по её номеру.
# goto: Перейти к указанной странице, началу или концу.
# input_abort: Отменить ввод и вернуться к чтению.
# input_activate: Выполнить введённую команду/поиск.
# input_completion: Выбрать пункт или группу автодополнения.
# input_edit: Редактировать строку команды/поиска.
# input_history: Выбрать предыдущую/следующую введённую команду.
# jumplist: Перейти по истории позиций чтения.
# mark_add: Поставить буквенную быструю метку.
# mark_evaluate: Перейти к буквенной быстрой метке.
# navigate: Следующая/предыдущая страница; advance-pages-per-row задаёт шаг разворота.
# navigate_index: Навигация/сворачивание/выбор пункта оглавления.
# nohlsearch: Скрыть подсветку поиска.
# page_mode: Выравнять размеры фиксированных страниц.
# print: Открыть диалог печати.
# quit: Закрыть программу.
# recolor: Переключить перекрашивание.
# reload: Перечитать файл с сохранением текущего состояния.
# reset_page_effects: Сбросить яркость, контраст, гамму и насыщенность в 0.
# rotate: Повернуть страницы на 90 градусов.
# scroll: Прокрутить в заданном направлении; full-down/full-up в книге перелистывают точный разворот.
# search: Следующее/предыдущее совпадение поиска.
# set: Функция set; описание и аргументы ниже из документации.
# snap_to_page: Выравнять прокрутку по краю текущей страницы.
# toggle_fullscreen: Включить/выключить полноэкранное окно (режим клавиш не меняется).
# toggle_index: Показать/скрыть оглавление.
# toggle_inputbar: Показать/скрыть строку команд.
# toggle_page_mode: Переключить одну и две колонки.
# toggle_presentation: Войти/выйти из режима презентации.
# toggle_single_page_mode: Переключить непрерывную сетку и одну выбранную страницу.
# toggle_statusbar: Показать/скрыть строку состояния.
# toggle_time: Показать/скрыть местное время HH:MM перед номером страницы; обновляется автоматически.
# zoom: Изменить масштаб всего документа.
# zoom_page: Изменить масштаб отдельной страницы.
# Полный справочник функций и аргументов (англ.):
#   The following shortcut functions can be mapped:
#
#   * ``abort``
#
#     Switch back to normal mode.
#
#   * ``adjust_window``
#
#     Adjust page width. Possible arguments are ``best-fit`` and ``width``.
#
#   * ``change_mode``
#
#     Change current mode. Pass the desired mode as argument.
#
#   * ``copy_filepath``
#
#     Copy the full path of the currently opened document to the clipboard
#
#   * ``copy_link``
#
#     Copy a link target to the clipboard.
#
#   * ``cycle_first_column``
#
#     In multiple page layout, cycle the column in which the first page is displayed.
#
#   * ``display_link``:
#
#     Display link target.
#
#   * ``exec``:
#
#     Execute an external command. ``$FILE`` expands to the current document path,
#     ``$PAGE`` to the current page number, and ``$DBUS`` to the bus name of the
#     D-Bus interface.
#
#   * ``file_chooser``:
#
#     Open a File Chooser Dialog. Uses the native file chooser on Windows and MacOS,
#     desktop portals when available and otherwise GtkFileChooser.
#
#   * ``focus_inputbar``
#
#     Focus inputbar.
#
#   * ``follow``
#
#     Follow a link.
#
#   * ``goto``
#
#     Go to a certain page.
#
#   * ``jumplist``
#
#     Move forwards/backwards in the jumplist. Pass ``forward`` as argument to
#     move to the next entry and ``backward`` to move to the previous one.
#
#   * ``navigate``
#
#     Navigate to the next/previous page.
#
#   * ``navigate_index``
#
#     Navigate through the index.
#
#   * ``print``
#
#     Show the print dialog.
#
#   * ``page_mode``
#
#     Set the page sizing mode. Default is ``equal_none``, which doesn't resize
#     individual pages. ``equal_width`` and ``equal_height`` resizes each page to
#     have the same width and height respectively.
#
#   * ``quit``
#
#     Quit zatura.
#
#   * ``recolor``
#
#     Recolor pages.
#
#   * ``reload``
#
#     Reload the document.
#
#   * ``rotate``
#
#     Rotate the page. Pass ``rotate-ccw`` as argument for counterclockwise rotation
#     and ``rotate-cw`` for clockwise rotation.
#
#   * ``scroll``
#
#     Scroll.
#
#   * ``search``
#
#     Search next/previous item. Pass ``forward`` as argument to search for the next
#     hit and ``backward`` to search for the previous hit.
#
#   * ``set``
#
#     Set an option.
#
#   * ``snap_to_page``
#
#     Snaps to the current page. Equivalent to ``goto <current_page>``
#
#   * ``toggle_fullscreen``
#
#     Toggle fullscreen.
#
#   * ``toggle_index``
#
#     Show or hide index.
#
#   * ``toggle_inputbar``
#
#     Show or hide inputbar.
#
#   * ``toggle_page_mode``
#
#     Toggle between one and multiple pages per row.
#
#   * ``toggle_single_page_mode``
#
#     Toggle between displaying a page grid or a single page.
#
#   * ``toggle_statusbar``
#
#     Show or hide statusbar.
#
#   * ``zoom``
#
#     Zoom in or out.
#
#   * ``zoom_page``
#
#     Zoom in or out of the current page.
#
#   * ``mark_add``
#
#     Set a quickmark.
#
#   * ``mark_evaluate``
#
#     Go to a quickmark.
#
#   * ``feedkeys``
#
#     Simulate key presses. Note that all keys will be interpreted as if pressing a
#     key on the keyboard. To input uppercase letters, follow the same convention as
#     for key bindings, i.e. for ``X``, use ``<S-X>``.
#
#
# *Pass arguments*
#   Some shortcut function require or have optional arguments which influence the
#   behaviour of them. Those can be passed as the last argument:
#
#   ::
#
#     map <C-i> zoom in
#     map <C-o> zoom out
#
#   Possible arguments are:
#
#   * best-fit
#   * bottom
#   * backward
#   * collapse
#   * collapse-recursive
#   * collapse-all
#   * default
#   * down
#   * expand
#   * expand-recursive
#   * expand-all
#   * forward
#   * full-down
#   * full-up
#   * half-down
#   * half-up
#   * smooth-down
#   * smooth-up
#   * in
#   * left
#   * next
#   * out
#   * page-bottom
#   * page-top
#   * previous
#   * right
#   * rotate-ccw
#   * rotate-cw
#   * select
#   * specific
#   * toggle
#   * top
#   * up
#   * width
#   * equal_none
#   * equal_width
#   * equal_height
#

# =================== ПОЛЬЗОВАТЕЛЬСКИЕ ИЗМЕНЕНИЯ ===================
# Добавляйте настройки ниже: последние строки имеют приоритет.
# Сброс изображения можно назначить отдельно, например:
# map [normal] <C-0> reset_page_effects
