# Generated defaults. Copy only overrides into ~/.config/zatura/zaturarc.
# Options: doc/man/zaturarc.5.rst. C=Ctrl, A=Alt, S=Shift; physical US keys.

set abort-clear-search true
set adjust-open "best-fit"
set advance-pages-per-row true
set completion-bg "#232323"
set completion-fg "#DDDDDD"
set completion-group-bg "#000000"
set completion-group-fg "#DEDEDE"
set completion-highlight-bg "#9FBC00"
set completion-highlight-fg "#232323"
set continuous-hist-save false
set database "sqlite" # startup only
set dbus-raise-window true
set dbus-service true
set default-bg "#000000"
set default-fg "#DDDDDD"
set double-click-follow true
set exec-command ""
set filemonitor "glib" # startup only
set first-page-column "1:2"
set font "monospace normal 9"
set guioptions "s"
set highlight-active-color "rgba(0,188,0,0.5)"
set highlight-color "rgba(159,251,0,0.5)"
set highlight-fg "rgba(0,0,0,0.5)"
set highlighter-modifier "shift"
set incremental-search false
set index-active-bg "#9FBC00"
set index-active-fg "#232323"
set index-bg "#232323"
set index-fg "#DDDDDD"
set inputbar-bg "#131313"
set inputbar-fg "#9FBC00"
set jumplist-size 2000
set link-hadjust true
set link-zoom true
set n-completion-items 15 # startup only
set nohlsearch false
set notification-bg "#FFFFFF"
set notification-error-bg "#FF1212"
set notification-error-fg "#FFFFFF"
set notification-fg "#000000"
set notification-warning-bg "#F3F000"
set notification-warning-fg "#000000"
set open-first-page false
set open-link-confirm true
set page-brightness 0
set page-cache-memory 256
set page-cache-size 16 # startup only
set page-contrast 0
set page-gamma 0
set page-h-padding 1
set page-mode "none"
set page-right-to-left false
set page-saturation 0
set page-thumbnail-size 4194304 # startup only
set page-v-padding 1
set pages-per-row 1
set recolor false
set recolor-adjust-lightness false
set recolor-darkcolor "#FFFFFF"
set recolor-keephue false
set recolor-lightcolor "#000000"
set recolor-reverse-video false
set reflow-font-size 12
set reflow-margin-bottom 4
set reflow-margin-inner 4
set reflow-margin-outer 4
set reflow-margin-top 4
set render-loading true
set render-loading-bg "#FFFFFF"
set render-loading-fg "#000000"
set save-view-settings true
set scroll-full-overlap 0.0
set scroll-hstep 40.0
set scroll-page-aware false
set scroll-step 40.0
set scroll-wrap false
set scrollbar-bg "#000000"
set scrollbar-fg "#DDDDDD"
set search-hadjust true
set selection-clipboard "primary"
set selection-keep-highlight false
set selection-notification false
set show-directories true
set show-hidden false
set show-recent 10
set show-signature-information false
set signature-error-color "rgba(92%,11%,14%,0.9)"
set signature-success-color "rgba(18%,80%,33%,0.9)"
set signature-warning-color "rgba(100%,84%,0%,0.9)"
set single-page-mode false
set statusbar-basename false
set statusbar-bg "#000000"
set statusbar-fg "#FFFFFF"
set statusbar-h-padding 8 # startup only
set statusbar-home-tilde false
set statusbar-page-percent false
set statusbar-show-time false
set statusbar-v-padding 2 # startup only
set synctex true
set synctex-edit-modifier "ctrl"
set synctex-editor-command ""
set vertical-center false
set window-decoration true # startup only
set window-height 600 # startup only
set window-title-basename false
set window-title-home-tilde false
set window-title-page false
set window-width 800 # startup only
set word-separator " /.-=&#?" # startup only
set zoom-center false
set zoom-max 1000
set zoom-min 10
set zoom-step 10


# normal
map [normal] a adjust_window best-fit
map [normal] s adjust_window width
map [normal] F display_link
map [normal] c copy_link
map [normal] / focus_inputbar "/"
map [normal] '<S-/>' focus_inputbar "/"
map [normal] '?' focus_inputbar "?"
map [normal] : focus_inputbar ":"
map [normal] o focus_inputbar ":open "
map [normal] O focus_inputbar append-filepath ":open "
map [normal] f follow
map [normal] gg goto top
map [normal] '<Home>' goto top
map [normal] '<KPHome>' goto top
map [normal] G goto bottom
map [normal] '<End>' goto bottom
map [normal] '<KPEnd>' goto bottom
map [normal] m mark_add
map [normal] ''"'"'' mark_evaluate
map [normal] J navigate next
map [normal] K navigate previous
map [normal] '<A-Right>' navigate next
map [normal] '<A-KPRight>' navigate next
map [normal] '<A-Left>' navigate previous
map [normal] '<A-KPLeft>' navigate previous
map [normal] '<PageDown>' navigate next
map [normal] '<KP_Page_Down>' navigate next
map [normal] '<PageUp>' navigate previous
map [normal] '<KP_Page_Up>' navigate previous
map [normal] '<Forward>' navigate next
map [normal] '<Back>' navigate previous
map [normal] '<C-p>' print
map [normal] '<C-r>' recolor
map [normal] R reload
map [normal] r rotate rotate-cw
map [normal] h scroll left
map [normal] j scroll down
map [normal] k scroll up
map [normal] l scroll right
map [normal] '<Left>' scroll left
map [normal] '<KPLeft>' scroll left
map [normal] '<Up>' scroll up
map [normal] '<KPUp>' scroll up
map [normal] '<Down>' scroll down
map [normal] '<KPDown>' scroll down
map [normal] H scroll page-top
map [normal] L scroll page-bottom
map [normal] '<Right>' scroll right
map [normal] '<KPRight>' scroll right
map [normal] '<C-t>' scroll half-left
map [normal] '<A-k>' scroll partial-up
map [normal] '<A-j>' scroll partial-down
map [normal] '<A-Up>' scroll partial-up
map [normal] '<A-KPUp>' scroll partial-up
map [normal] '<A-Down>' scroll partial-down
map [normal] '<A-KPDown>' scroll partial-down
map [normal] '<C-d>' scroll half-down
map [normal] '<C-u>' scroll half-up
map [normal] '<C-y>' scroll half-right
map [normal] t toggle_time
map [normal] '<C-f>' scroll full-down
map [normal] '<C-b>' scroll full-up
map [normal] y scroll full-right
map [normal] '<Space>' scroll full-down
map [normal] '<S-Space>' scroll full-up
map [normal] Y copy_filepath
map [normal] '<C-o>' jumplist backward
map [normal] '<C-i>' jumplist forward
map [normal] '<C-j>' bisect forward
map [normal] '<C-k>' bisect backward
map [normal] n search forward
map [normal] N search backward
map [normal] P snap_to_page
map [normal] '<Tab>' toggle_index
map [normal] '<C-n>' toggle_statusbar
map [normal] '<C-m>' toggle_inputbar
map [normal] d toggle_page_mode
map [normal] D cycle_first_column
map [normal] '<C-->' adjust_book_font down
map [normal] '<C-=>' adjust_book_font up
map [normal] '<C-+>' adjust_book_font up
map [normal] '<C-KPAdd>' adjust_book_font up
map [normal] '<C-KPSubtract>' adjust_book_font down
map [normal] + zoom in
map [normal] '<KPAdd>' zoom in
map [normal] - zoom out
map [normal] '<KPSubtract>' zoom out
map [normal] = zoom specific
map [normal] zi zoom in
map [normal] zI zoom in
map [normal] zo zoom out
map [normal] zO zoom out
map [normal] z0 zoom original
map [normal] zz zoom specific
map [normal] zZ zoom specific
map [normal] '<A-o>' file_chooser
map [normal] '<C-c>' abort
map [normal] '<Esc>' abort
map [normal] '<C-[>' abort
map [normal] q quit
map [normal] '<F5>' toggle_presentation
map [normal] '<F11>' toggle_fullscreen
map [normal] w toggle_single_page_mode
map [normal] 1 adjust_contrast down
map [normal] 2 adjust_contrast up
map [normal] 3 adjust_brightness down
map [normal] 4 adjust_brightness up
map [normal] 5 adjust_gamma down
map [normal] 6 adjust_gamma up
map [normal] 7 adjust_saturation down
map [normal] 8 adjust_saturation up

# presentation
map [presentation] '<C-c>' abort
map [presentation] '<Esc>' abort
map [presentation] '<C-[>' abort
map [presentation] q quit
map [presentation] '<F11>' toggle_fullscreen
map [presentation] J navigate next
map [presentation] '<Down>' navigate next
map [presentation] '<KPDown>' navigate next
map [presentation] '<Right>' navigate next
map [presentation] '<KPRight>' navigate next
map [presentation] '<PageDown>' navigate next
map [presentation] '<KP_Page_Down>' navigate next
map [presentation] '<Forward>' navigate next
map [presentation] '<Space>' navigate next
map [presentation] K navigate previous
map [presentation] '<Left>' navigate previous
map [presentation] '<KPLeft>' navigate previous
map [presentation] '<Up>' navigate previous
map [presentation] '<KPUp>' navigate previous
map [presentation] '<PageUp>' navigate previous
map [presentation] '<KP_Page_Up>' navigate previous
map [presentation] '<Back>' navigate previous
map [presentation] '<S-Space>' navigate previous
map [presentation] '<BackSpace>' navigate previous
map [presentation] '<F5>' toggle_presentation
map [presentation] t toggle_time
map [presentation] 1 adjust_contrast down
map [presentation] 2 adjust_contrast up
map [presentation] 3 adjust_brightness down
map [presentation] 4 adjust_brightness up
map [presentation] 5 adjust_gamma down
map [presentation] 6 adjust_gamma up
map [presentation] 7 adjust_saturation down
map [presentation] 8 adjust_saturation up

# index
map [index] '<C-c>' toggle_index
map [index] '<Esc>' toggle_index
map [index] '<C-[>' toggle_index
map [index] q quit
map [index] '<F11>' toggle_fullscreen
map [index] '<Tab>' toggle_index
map [index] k navigate_index up
map [index] j navigate_index down
map [index] '<C-d>' navigate_index half-down
map [index] '<C-u>' navigate_index half-up
map [index] h navigate_index collapse
map [index] zc navigate_index collapse
map [index] zC navigate_index collapse-recursive
map [index] H navigate_index collapse-all
map [index] zM navigate_index collapse-all
map [index] l navigate_index expand
map [index] zo navigate_index expand
map [index] zO navigate_index expand-recursive
map [index] L navigate_index expand-all
map [index] zR navigate_index expand-all
map [index] '<Up>' navigate_index up
map [index] '<KPUp>' navigate_index up
map [index] '<Down>' navigate_index down
map [index] '<KPDown>' navigate_index down
map [index] '<Left>' navigate_index collapse
map [index] '<KPLeft>' navigate_index collapse
map [index] '<Right>' navigate_index expand
map [index] '<KPRight>' navigate_index expand
map [index] '<Space>' navigate_index select
map [index] '<Return>' navigate_index select
map [index] '<C-j>' navigate_index select
map [index] gg navigate_index top
map [index] G navigate_index bottom

# insert
map [insert] '<C-c>' abort
map [insert] '<Esc>' abort
map [insert] '<C-[>' abort
map [insert] q quit
map [insert] '<F11>' toggle_fullscreen

# inputbar
map [inputbar] '<F11>' toggle_fullscreen
map [inputbar] '<Esc>' abort
map [inputbar] '<C-c>' abort
map [inputbar] '<C-j>' input_activate
map [inputbar] '<C-[>' input_abort
map [inputbar] '<Tab>' input_completion input-next
map [inputbar] '<C-Tab>' input_completion input-next-group
map [inputbar] '<ShiftTab>' input_completion input-previous
map [inputbar] '<C-ShiftTab>' input_completion input-previous-group
map [inputbar] '<BackSpace>' input_edit delete-last-char
map [inputbar] '<C-h>' input_edit delete-last-char
map [inputbar] '<C-u>' input_edit delete-to-line-start
map [inputbar] '<C-k>' input_edit delete-to-line-end
map [inputbar] '<C-d>' input_edit delete-current-char
map [inputbar] '<C-w>' input_edit delete-last-word
map [inputbar] '<C-f>' input_edit next-char
map [inputbar] '<C-b>' input_edit previous-char
map [inputbar] '<Right>' input_edit next-char
map [inputbar] '<Left>' input_edit previous-char
map [inputbar] '<C-a>' input_edit line-start
map [inputbar] '<C-e>' input_edit line-end
map [inputbar] '<Up>' input_history input-previous
map [inputbar] '<Down>' input_history input-next
map [inputbar] '<C-p>' input_history input-previous
map [inputbar] '<C-n>' input_history input-next
