# Complete custom suffix based on libraries installed
function __fish_complete_zatura
    for plugin in @PLUGINDIR@/*.so
        switch (basename $plugin)
            case libpdf-poppler.so
                __fish_complete_suffix .pdf
            case libpdf-mupdf.so
                __fish_complete_suffix .pdf
                __fish_complete_suffix .epub
                __fish_complete_suffix .oxps
            case libps.so
                __fish_complete_suffix .ps
                __fish_complete_suffix .eps
                __fish_complete_suffix .epsi
                __fish_complete_suffix .epsf
            case libdjvu.so
                __fish_complete_suffix .djvu
                __fish_complete_suffix .djv
            case libcb.so
                __fish_complete_suffix .cb7
                __fish_complete_suffix .cbr
                __fish_complete_suffix .cbz
                __fish_complete_suffix .cbt
                __fish_complete_suffix .rar
                __fish_complete_suffix .zip
                __fish_complete_suffix .7z
                __fish_complete_suffix .tar
        end
    end
end

complete -c zatura -kxa '(__fish_complete_zatura)'

complete -c zatura -s e -l reparent -d 'Reparents to window specified by xid'
complete -c zatura -s c -l config-dir -d 'Path to config directory' \
         -x -a '(__fish_complete_directories (commandline -ct) "Config directory")'
complete -c zatura -s d -l data-dir -d 'Path to data directory' \
         -x -a '(__fish_complete_directories (commandline -ct) "Data directory")'
complete -c zatura -l cache-dir -d 'Path to cache directory' \
         -x -a '(__fish_complete_directories (commandline -ct) "Cache directory")'
complete -c zatura -s p -l plugins-dir -d 'Path to plugins directory' \
         -x -a '(__fish_complete_directories (commandline -ct) "Plugins directory")'
complete -c zatura -s w -l password -d 'Document password'
complete -c zatura -s P -l page -d 'Page number to go to'
complete -c zatura -s l -l log-level -d 'Log level' -x -a 'debug info warning error'
complete -c zatura -s x -l synctex-editor-command -d 'Synctex editor (forwarded to the synctex command)' -x
complete -c zatura -l synctex-forward -d 'Move to given synctex position' -x
complete -c zatura -l synctex-pid -d 'Highlight position in given process' -x -a '(__fish_complete_pids)'
complete -c zatura -l mode -d 'Start in a non-default mode' -x -a 'presentation'
complete -c zatura -l fullscreen -d 'Start with a fullscreen window'
complete -c zatura -l fork -d 'Fork into the background'
complete -c zatura -s h -l help -d 'Show help options'
complete -c zatura -s v -l version -d 'Print version information'
